appsettings.*.json
secrets.json
*.pfx

# Database
*.mdf
*.ldf
*.db
*.sqlite

# Logs
*.log

# Node/npm
node_modules/
wwwroot/lib/

# Resharper
_ReSharper*/
*.DotSettings.user

# Others
*.DS_Store

# End of .gitignore
